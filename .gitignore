# ============================================================================
# SJCD ASBL — .gitignore
# Projet : site institutionnel officiel (Next.js / React / TypeScript)
# ============================================================================

# --- Dépendances ------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/install-state.gz
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build & sortie ---------------------------------------------------------
.next/
out/
build/
dist/
.swc/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Cache outils -----------------------------------------------------------
.eslintcache
.stylelintcache
.cache/
.parcel-cache/

# --- Environnement & secrets ------------------------------------------------
# Ne JAMAIS committer de secret. Utiliser .env.example comme modèle documenté.
.env
.env.*
!.env.example
*.pem
*.key
!public/**/*.key
secrets/
.credentials/

# --- CMS / contenu généré ---------------------------------------------------
# Sortie de build du studio CMS ou des schémas générés
.cms/
payload-types.ts

# --- Tests ------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
playwright-report.json
test-results/
blob-report/
.playwright/
.lighthouseci/

# --- Dépendances & outillage système ---------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# --- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.dev-*.log

# --- Temporaires & brouillons ----------------------------------------------
tmp/
temp/
.tmp/
*.bak
*.orig
*.rej
# Brouillons éditoriaux et notes non publiables
_drafts/
_scratch/
# Archives et exports lourds (ne pas versionner les livrables binaires volumineux)
*.zip
*.tar.gz
# ⚠️ Exception volontaire : le dossier docs/ et specs/ est versionné (docs-as-code).
#    Ne pas y placer de binaires lourds ; utiliser un stockage externe et un lien.

# --- Fichiers de travail IA / outils ---------------------------------------
.arena/

# --- Politique de sécurité CI (voir docs/06) -------------------------------
# Bloquer l'ajout accidentel de fichiers contenant des identifiants
*.env.local
.env.production
.env.staging
