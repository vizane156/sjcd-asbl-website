    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
