# Documentation des variables d'environnement — SJCD ASBL
#
# Ce fichier est un MODÈLE versionné. Il ne contient AUCUN secret réel.
# Copier vers .env.local (ignoré par Git) et renseigner les valeurs.
#
#   cp .env.example .env.local
#
# Règle : un secret ne quitte JAMAIS le coffre du fournisseur (Vercel /
# gestionnaire de secrets). Les valeurs d'exemple ci-dessous sont fictives.

# ---------------------------------------------------------------------------
# 1. Site & SEO
# ---------------------------------------------------------------------------
# URL canonique publique, sans slash final.
NEXT_PUBLIC_SITE_URL="https://example.org"

# Nom légal complet tel qu'il doit apparaître publiquement.
# TODO(SJCD): confirmer la dénomination officielle exacte (voir D1/D2).
NEXT_PUBLIC_ORG_LEGAL_NAME="Salon de Jeunes Chandelier pour le Développement"

# Référence d’enregistrement de l’ASBL en RDC (autorité et numéro à confirmer).
# TODO(SJCD): valeur requise pour les mentions légales.
NEXT_PUBLIC_ORG_REGISTRATION_NUMBER=""

# Locale par défaut (fr) et locales activées, séparées par des virgules.
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_LOCALES="fr"

# Indexation : 'true' en production, 'false' sur les environnements de test.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# ---------------------------------------------------------------------------
# 2. Contact & e-mail transactionnel
# ---------------------------------------------------------------------------
# Adresse de destination des formulaires (jamais exposée côté client).
CONTACT_INBOX_EMAIL=""

# Clé d'API du fournisseur d'e-mail (Resend / Postmark / SMTP).
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="SJCD ASBL"

# ---------------------------------------------------------------------------
# 3. Anti-spam (voir docs/06 — Sécurité)
# ---------------------------------------------------------------------------
# Clés site/serveur d'un service type Cloudflare Turnstile (alternative RGPD
# à reCAPTCHA). Sans elles, un rate limiting applicatif doit être actif.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# 4. Analytics respectueux de la vie privée
# ---------------------------------------------------------------------------
# Aucun traceur non essentiel ne doit être chargé sans consentement (RGPD).
ANALYTICS_ENABLED="false"
ANALYTICS_DOMAIN=""
ANALYTICS_PROVIDER="plausible" # plausible | umami | matomo | none

# ---------------------------------------------------------------------------
# 5. CMS (voir D6 — décision de plateforme)
# ---------------------------------------------------------------------------
CMS_PROJECT_ID=""
CMS_DATASET="production"
CMS_API_TOKEN="" # lecture seule, serveur
CMS_PREVIEW_TOKEN="" # prévisualisation de brouillons

# ---------------------------------------------------------------------------
# 6. Dons (voir D10 — décision requise avant activation)
# ---------------------------------------------------------------------------
# Ne renseigner qu'après validation juridique et fiscale des dons (D10).
DONATIONS_ENABLED="false"
PAYMENT_PROVIDER="" # stripe | mollie | none
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
